{
  "name": "Task Reminder",
  "description": "Task Reminder - Aplikasi pengelolaan tugas kuliah dengan notifikasi WhatsApp otomatis (Next.js + Go + whatsmeow)",
  "author": "Task Reminder Team",
  "version": "2.0.0",
  "docker_image": "ghcr.io/parkervcp/yolks:node_20",
  "startup_command": "./entrypoint.sh",
  "scripts": {
    "installation": {
      "script": "apk add --no-cache dumb-init sqlite tzdata go && npm install -g pnpm@12.11.2 && pnpm install --frozen-lockfile && pnpm --filter @task-reminder/frontend build && cd backend && CGO_ENABLED=0 go build -o /app/bin/server ./cmd/server && mkdir -p /app/data",
      "container": "alpine:3.20",
      "entrypoint": "sh"
    },
    "startup": {
      "script": "./entrypoint.sh",
      "container": "ghcr.io/parkervcp/yolks:node_20",
      "entrypoint": "sh"
    }
  },
  "variables": [
    {
      "name": "Port",
      "description": "Port public frontend aplikasi",
      "env_variable": "PORT",
      "default_value": "3000",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|numeric|min:1|max:65535"
    },
    {
      "name": "Backend Port",
      "description": "Port internal API Go Fiber",
      "env_variable": "BACKEND_PORT",
      "default_value": "8080",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|numeric|min:1|max:65535"
    },
    {
      "name": "Database Path",
      "description": "Path file database SQLite (harus di volume persisten)",
      "env_variable": "DATABASE_PATH",
      "default_value": "/app/data/task-reminder.sqlite",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required"
    },
    {
      "name": "WhatsApp Store Path",
      "description": "Path file database sesi WhatsApp whatsmeow (volume persisten)",
      "env_variable": "WHATSAPP_STORE_PATH",
      "default_value": "/app/data/whatsapp.sqlite",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required"
    },
    {
      "name": "Admin Phone",
      "description": "Nomor WhatsApp admin awal untuk login pertama kali",
      "env_variable": "ADMIN_PHONE",
      "default_value": "6281234567890",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required"
    },
    {
      "name": "Admin Password",
      "description": "Password admin awal",
      "env_variable": "ADMIN_PASSWORD",
      "default_value": "adminpassword123",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required|string|min:6"
    },
    {
      "name": "Timezone",
      "description": "Zona waktu aplikasi (Asia/Jakarta, Asia/Makassar, Asia/Jayapura)",
      "env_variable": "APP_TIMEZONE",
      "default_value": "Asia/Jakarta",
      "user_viewable": true,
      "user_editable": true,
      "rules": "required"
    }
  ]
}
