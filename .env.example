# App Environment
APP_ENV=production
PORT=3000
BACKEND_PORT=8080

# Database & WhatsApp Persistence
DATABASE_PATH=./data/task-reminder.sqlite
WHATSAPP_STORE_PATH=./data/whatsapp.sqlite

# URLs & CORS
# Set * to allow Cloudflare Tunnel domains, ZeroTier IPs, and local LAN automatically.
# Or specify comma-separated origins: https://reminder.mydomain.com,http://10.147.x.x:3000
CORS_ORIGIN=*
# Optional: Set to true/false to force cookie secure flag. Default is auto-detect based on HTTPS header.
# FORCE_SECURE_COOKIE=false

# Admin Seed Account
ADMIN_PHONE=6281234567890
ADMIN_PASSWORD=adminpassword123

# Timezone
APP_TIMEZONE=Asia/Jakarta
