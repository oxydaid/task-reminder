# ==============================================================================
# Task Reminder - Configuration Environment
# ==============================================================================

# App Environment
APP_ENV=production

# Custom Ports (Bisa disesuaikan agar tidak bentrok dengan service lain di server)
# Port Frontend (Web Next.js) - Default 3000
PORT=3000

# Port Backend (API Go Fiber) - Default 8080
BACKEND_PORT=8080

# Database & WhatsApp Persistence (SQLite)
DATABASE_PATH=./data/task-reminder.sqlite
WHATSAPP_STORE_PATH=./data/whatsapp.sqlite

# URLs & CORS
# Set * untuk mengizinkan Cloudflare Tunnel, IP ZeroTier, dan IP LAN otomatis.
# Atau tentukan asal domain spesifik: https://reminder.domainanda.com,http://10.147.19.45:3000
CORS_ORIGIN=*

# Admin Seed Account (Otomatis dibuat saat database pertama kali diinisialisasi)
ADMIN_PHONE=6281234567890
ADMIN_PASSWORD=adminpassword123

# Timezone Scheduler Notifikasi
APP_TIMEZONE=Asia/Jakarta
