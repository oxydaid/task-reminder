{
  "name": "task-reminder",
  "version": "1.0.0",
  "description": "Task Reminder - Web App untuk pengelolaan tugas kuliah dengan notifikasi WhatsApp",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev:frontend": "pnpm --filter @task-reminder/frontend dev",
    "dev:backend": "cd backend && go run ./cmd/server",
    "build:frontend": "pnpm --filter @task-reminder/frontend build",
    "build:backend": "cd backend && go build -o ../bin/server ./cmd/server",
    "build": "pnpm build:frontend && pnpm build:backend",
    "build:sh": "bash ./build.sh",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "start:frontend": "pnpm --filter @task-reminder/frontend start",
    "start:backend": "./bin/server",
    "typecheck": "pnpm --filter @task-reminder/frontend typecheck"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
